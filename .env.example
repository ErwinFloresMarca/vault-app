# Database (dedicada a Volt Vault; el Postgres activo está en 127.0.0.1:5432, owner volt3d-coins)
DATABASE_URL="postgresql://volt3d-coins:@127.0.0.1:5432/vault-volt3d"

# OAuth - Google
NUXT_OAUTH_GOOGLE_ID="your-google-client-id"
NUXT_OAUTH_GOOGLE_SECRET="your-google-client-secret"

# OAuth - Facebook
NUXT_OAUTH_FACEBOOK_ID="your-facebook-app-id"
NUXT_OAUTH_FACEBOOK_SECRET="your-facebook-app-secret"

# Session
NUXT_SESSION_PASSWORD="your-32-character-secret-key-here!"

# MCP (servidor de asistentes IA) — pepper para el hash de las API keys
MCP_KEY_PEPPER="your-mcp-key-pepper"

# API
NUXT_API_BASE_URL="http://localhost:3000"

# URL pública del sitio (canonical / og:url / sitemap)
NUXT_PUBLIC_SITE_URL="http://localhost:3000"

# Exchange Rate API (for USD to BOB)
NUXT_EXCHANGE_RATE_API_KEY="your-api-key"

# Email
NUXT_SMTP_HOST="smtp.example.com"
NUXT_SMTP_PORT="587"
NUXT_SMTP_USER="your-email@example.com"
NUXT_SMTP_PASS="your-password"
NUXT_SMTP_FROM="noreply@volt3d.com"

# Pedidos (m21): correo(s) que reciben el aviso de cada pedido nuevo, separados por comas.
# Requiere configurar NUXT_SMTP_* (p. ej. Gmail con "contraseña de aplicación": host smtp.gmail.com, puerto 465).
NUXT_ORDER_NOTIFY_EMAIL="tu-correo@gmail.com"
# QR de pago que se muestra en el correo "Pedido realizado" (p. ej. /images/qr-pago.png en public/).
NUXT_PAYMENT_QR_URL=""

# Administradores: correos (separados por comas) que reciben el rol ADMIN al iniciar sesión.
NUXT_ADMIN_EMAILS=""
