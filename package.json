{
  "name": "vault-app",
  "private": true,
  "type": "module",
  "version": "0.3.2",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare && prisma generate",
    "typecheck": "nuxt typecheck",
    "e2e": "node scripts/e2e-auth.mjs",
    "e2e:mcp": "node scripts/e2e-mcp.mjs",
    "mcp:key": "tsx scripts/mcp-key.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "prisma migrate reset",
    "release": "bash scripts/release.sh",
    "deploy": "bash deploy.sh"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@nuxt/content": "3.14.0",
    "@nuxt/eslint": "1.15.2",
    "@nuxt/fonts": "0.14.0",
    "@nuxt/hints": "1.1.2",
    "@nuxt/icon": "2.2.3",
    "@nuxt/image": "2.0.0",
    "@nuxt/ui": "4.8.2",
    "@nuxtjs/mdc": "0.22.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "better-sqlite3": "^12.10.0",
    "eslint": "^10.3.0",
    "nuxt": "^4.4.7",
    "nuxt-auth-utils": "^0.5.29",
    "pg": "^8.21.0",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.9.3",
    "vue": "^3.5.35",
    "zod": "^4.6.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "@prisma/engines",
      "better-sqlite3",
      "esbuild",
      "prisma"
    ],
    "ignoredBuiltDependencies": [
      "sharp",
      "unrs-resolver",
      "vue-demi"
    ]
  },
  "devDependencies": {
    "@iconify-json/logos": "^1.2.11",
    "@iconify-json/lucide": "^1.2.111",
    "@types/node": "^25.9.2",
    "dotenv": "^17.4.2",
    "playwright": "1.63.0",
    "prisma": "^7.8.0",
    "vue-tsc": "^3.3.11"
  }
}
