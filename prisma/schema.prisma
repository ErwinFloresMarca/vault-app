// Volt Vault - Catálogo de coleccionables impresos en 3D
// Schema Prisma completo (rehecho desde cero sobre la infra de auth existente)

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ===== AUTH =====

enum UserRole {
  USER
  ADMIN
}

model User {
  id          String   @id @default(cuid())
  email       String   @unique
  name        String
  avatarUrl   String?
  role        UserRole @default(USER)
  lastLoginAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  oauthAccounts OAuthAccount[]
  collected     UserCollectedItem[]
}

model OAuthAccount {
  id         String  @id @default(cuid())
  userId     String
  provider   String // "google" | "facebook"
  providerId String
  email      String
  name       String
  avatarUrl  String?

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([provider, providerId])
  @@index([userId])
}

// ===== FILES (imágenes y recursos) =====

model File {
  id        String    @id @default(cuid())
  url       String    @unique // URL de acceso (web o /uploads/... local)
  path      String? // ruta local en disco si aplica
  mimeType  String?
  size      Int?
  createdAt DateTime  @default(now())

  collections CollectionFile[]
  items       ItemFile[]

  @@index([url])
}

// ===== CATÁLOGO =====

enum CollectionStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ItemStatus {
  DRAFT
  AVAILABLE
  SOLD_OUT
  ARCHIVED
}

model Collection {
  id          String           @id @default(cuid())
  name        String
  slug        String           @unique
  description String? // Markdown enriquecido
  status      CollectionStatus @default(DRAFT)
  orderIndex  Int              @default(0) // orden de exhibición
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  items      CollectionItem[]
  tags       CollectionTag[]
  files      CollectionFile[]

  @@index([status])
}

model CollectionItem {
  id           String     @id @default(cuid())
  collectionId String
  name         String
  slug         String     @unique
  description  String?
  stock        Int        @default(0) // denormalizado, se actualiza atómicamente con movimientos
  soldQuantity Int        @default(0) // denormalizado, derivado de movimientos SALE
  status       ItemStatus @default(DRAFT)
  orderIndex   Int        @default(0)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  collection  Collection    @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  files       ItemFile[]
  movements   InventoryMovement[]
  collectedBy UserCollectedItem[]

  @@index([collectionId])
  @@index([status])
}

// ===== TAGS =====

model Tag {
  id        String        @id @default(cuid())
  name      String        @unique
  slug      String        @unique
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  collections CollectionTag[]
}

model CollectionTag {
  collectionId String
  tagId        String

  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  tag        Tag        @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([collectionId, tagId])
  @@index([tagId])
}

// ===== RELACIONES FILE ↔ CATÁLOGO (M:N) =====

model CollectionFile {
  id           String @id @default(cuid())
  collectionId String
  fileId       String
  position     Int    @default(0) // 0 = portada
  alt          String?

  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  file       File       @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@unique([collectionId, fileId])
  @@index([fileId])
}

model ItemFile {
  id       String @id @default(cuid())
  itemId   String
  fileId   String
  position Int    @default(0) // 0 = imagen principal
  alt      String?

  item CollectionItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  file File           @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@unique([itemId, fileId])
  @@index([fileId])
}

// ===== ELEMENTOS CONSEGUIDOS =====

model UserCollectedItem {
  id         String   @id @default(cuid())
  userId     String
  itemId     String
  obtainedAt DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  item CollectionItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([userId, itemId])
  @@index([itemId])
}

// ===== INVENTARIO =====

enum InventoryMovementType {
  IN
  OUT
  ADJUSTMENT
  SALE
}

model InventoryMovement {
  id        String               @id @default(cuid())
  itemId    String
  type      InventoryMovementType
  quantity  Int
  reason    String?
  createdAt DateTime             @default(now())

  item CollectionItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([itemId])
}
