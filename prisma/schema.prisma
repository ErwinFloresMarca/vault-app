// Volt Vault - Catálogo de coleccionables impresos en 3D
// Schema Prisma completo (rehecho desde cero sobre la infra de auth existente)

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ===== AUTH =====

enum UserRole {
  USER
  ADMIN
}

model User {
  id          String   @id @default(cuid())
  email       String   @unique
  name        String
  avatarUrl   String?
  role        UserRole @default(USER)
  xp          Int      @default(0)
  lastLoginAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  oauthAccounts OAuthAccount[]
  collected     UserCollectedItem[]
  wishlist      UserWishlistItem[]
  achievements  UserAchievement[]
  apiKeys       ApiKey[]

  registeredBatches   InventoryBatch[]    @relation("RegisteredBy")
  customerBatches     InventoryBatch[]    @relation("Customer")
  registeredMovements InventoryMovement[] @relation("RegisteredBy")
  customerMovements   InventoryMovement[] @relation("Customer")

  orders        Order[] @relation("OrderCustomer")
  printedOrders Order[] @relation("OrderPrinter")
}

model OAuthAccount {
  id         String  @id @default(cuid())
  userId     String
  provider   String // "google" | "facebook"
  providerId String
  email      String
  name       String
  avatarUrl  String?

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([provider, providerId])
  @@index([userId])
}

// ===== FILES (imágenes y recursos) =====

model File {
  id        String   @id @default(cuid())
  url       String   @unique // URL de acceso (web o /uploads/... local)
  path      String? // ruta local en disco si aplica
  mimeType  String?
  size      Int?
  createdAt DateTime @default(now())

  collections CollectionFile[]
  items       ItemFile[]

  @@index([url])
}

// ===== CATÁLOGO =====

enum CollectionStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ItemStatus {
  DRAFT
  AVAILABLE
  SOLD_OUT
  ARCHIVED
}

enum Rarity {
  COMMON
  RARE
  EPIC
  LEGENDARY
}

model Collection {
  id          String           @id @default(cuid())
  name        String
  slug        String           @unique
  description String? // Markdown enriquecido
  status      CollectionStatus @default(DRAFT)
  orderIndex  Int              @default(0) // orden de exhibición
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  items            CollectionItem[]
  tags             CollectionTag[]
  files            CollectionFile[]
  inventoryBatches InventoryBatch[]

  @@index([status])
}

model CollectionItem {
  id           String     @id @default(cuid())
  collectionId String
  name         String
  slug         String     @unique
  sourceUrl    String?    @unique // URL canónica del origen (importación externa)
  description  String?
  price        Decimal?   @db.Decimal(10, 2) // precio de venta en Bs (null = sin precio, no se vende por carrito)
  stock        Int        @default(0) // denormalizado, se actualiza atómicamente con movimientos
  soldQuantity Int        @default(0) // denormalizado, derivado de movimientos SALE
  status       ItemStatus @default(DRAFT)
  rarity       Rarity     @default(COMMON)
  orderIndex   Int        @default(0)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  collection  Collection          @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  files       ItemFile[]
  movements   InventoryMovement[]
  collectedBy UserCollectedItem[]
  wishlist    UserWishlistItem[]
  spec        ItemSpec?
  orderItems  OrderItem[]

  @@index([collectionId])
  @@index([status])
}

// Ficha técnica opcional del coleccionable (1:1 con el item).
model ItemSpec {
  id       String  @id @default(cuid())
  itemId   String  @unique
  scale    String? // Escala / Altura (p. ej. "18 cm")
  material String? // Material / Acabado (p. ej. "Vinilo mate")
  lighting String? // Iluminación integrada
  base     String? // Base / Soporte

  item CollectionItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
}

// ===== TAGS =====

model Tag {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  collections CollectionTag[]
}

model CollectionTag {
  collectionId String
  tagId        String

  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  tag        Tag        @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([collectionId, tagId])
  @@index([tagId])
}

// ===== RELACIONES FILE ↔ CATÁLOGO (M:N) =====

model CollectionFile {
  id           String  @id @default(cuid())
  collectionId String
  fileId       String
  position     Int     @default(0) // 0 = portada
  alt          String?

  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  file       File       @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@unique([collectionId, fileId])
  @@index([fileId])
}

model ItemFile {
  id       String  @id @default(cuid())
  itemId   String
  fileId   String
  position Int     @default(0) // 0 = imagen principal
  alt      String?

  item CollectionItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  file File           @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@unique([itemId, fileId])
  @@index([fileId])
}

// ===== ELEMENTOS CONSEGUIDOS =====

model UserCollectedItem {
  id         String   @id @default(cuid())
  userId     String
  itemId     String
  obtainedAt DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  item CollectionItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([userId, itemId])
  @@index([itemId])
}

// ===== WISHLIST (lo quiero) =====

model UserWishlistItem {
  id        String   @id @default(cuid())
  userId    String
  itemId    String
  createdAt DateTime @default(now())

  user User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  item CollectionItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([userId, itemId])
  @@index([itemId])
}

// ===== INVENTARIO =====

enum InventoryMovementType {
  IN
  OUT
  ADJUSTMENT
  SALE
}

// Agrupa uno o más InventoryMovement que se registran a la vez
// (p.ej. imprimir una tanda de items de una colección).
// collectionId es opcional para permitir agrupar items de varias colecciones.
model InventoryBatch {
  id           String                @id @default(cuid())
  collectionId String?
  type         InventoryMovementType
  reason       String?

  // Persona que registra/interactúa con el sistema (siempre se persiste).
  registeredByUserId String?
  registeredByName   String?
  registeredByEmail  String?

  // Persona a quien se vende/entrega. Obligatoria solo para OUT y SALE.
  customerUserId String?
  customerName   String?
  customerEmail  String?

  createdAt DateTime @default(now())

  collection   Collection?         @relation(fields: [collectionId], references: [id], onDelete: SetNull)
  movements    InventoryMovement[]
  registeredBy User?               @relation("RegisteredBy", fields: [registeredByUserId], references: [id], onDelete: SetNull)
  customer     User?               @relation("Customer", fields: [customerUserId], references: [id], onDelete: SetNull)

  @@index([collectionId])
  @@index([createdAt])
}

model InventoryMovement {
  id       String                @id @default(cuid())
  itemId   String
  batchId  String?
  type     InventoryMovementType
  quantity Int
  reason   String?

  // Persona que registra (heredada del batch en movimientos agrupados).
  registeredByUserId String?
  registeredByName   String?
  registeredByEmail  String?

  // Persona a quien se vende/entrega (obligatoria solo para OUT y SALE).
  customerUserId String?
  customerName   String?
  customerEmail  String?

  createdAt DateTime @default(now())

  item         CollectionItem  @relation(fields: [itemId], references: [id], onDelete: Cascade)
  batch        InventoryBatch? @relation(fields: [batchId], references: [id], onDelete: Cascade)
  registeredBy User?           @relation("RegisteredBy", fields: [registeredByUserId], references: [id], onDelete: SetNull)
  customer     User?           @relation("Customer", fields: [customerUserId], references: [id], onDelete: SetNull)

  @@index([itemId])
  @@index([batchId])
  @@index([registeredByUserId])
  @@index([customerUserId])
}

// ===== MCP (servidor para asistentes IA) =====

model ApiKey {
  id         String    @id @default(cuid())
  name       String
  keyHash    String    @unique
  prefix     String
  userId     String
  scopes     String[]
  lastUsedAt DateTime?
  expiresAt  DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model McpAuditLog {
  id         String   @id @default(cuid())
  apiKeyId   String?
  userId     String?
  tool       String
  args       Json
  result     String
  statusCode Int?
  error      String?
  ip         String?
  userAgent  String?
  durationMs Int
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([apiKeyId])
}

// ===== GAMIFICACIÓN (XP, niveles e insignias) =====

model Achievement {
  id          String  @id @default(cuid())
  key         String  @unique // slug estable (p. ej. "first-item")
  name        String
  description String?
  icon        String? // i-lucide-*
  xpReward    Int     @default(0)
  sortOrder   Int     @default(0)

  unlocks UserAchievement[]
}

model UserAchievement {
  id            String   @id @default(cuid())
  userId        String
  achievementId String
  unlockedAt    DateTime @default(now())

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@unique([userId, achievementId])
  @@index([achievementId])
}

// ===== PEDIDOS (carrito / checkout, m21) =====

enum OrderStatus {
  PENDING_PAYMENT // creado desde el carrito, esperando pago por QR
  PAID
  IN_PRODUCTION
  READY
  SHIPPED
  DELIVERED
  CANCELLED
}

enum DeliveryMethod {
  PICKUP // retiro / entrega en la ciudad
  SHIPPING // envío departamental (costo adicional)
}

model Order {
  id     String      @id @default(cuid())
  number Int         @unique @default(autoincrement()) // correlativo interno (solo admin)
  code   String      @unique // código único que ve el cliente (p. ej. VV-7K3P-Q9RT)
  status OrderStatus @default(PENDING_PAYMENT)

  // Cliente (puede pedir sin cuenta; si tiene sesión se vincula userId).
  // El correo es el contacto principal; WhatsApp es secundario.
  userId         String?
  customerName   String
  customerPhone  String? // WhatsApp (contacto secundario)
  customerEmail  String // correo (contacto principal: avisos del pedido)
  customerCity   String
  deliveryMethod DeliveryMethod @default(PICKUP)
  address        String?
  notes          String?

  // Montos en Bs
  subtotal     Decimal @db.Decimal(10, 2)
  shippingCost Decimal @default(0) @db.Decimal(10, 2)

  // Reparto entre socios (contrato): quien imprime recupera su costo y la
  // utilidad neta (total - costo de impresión - otros gastos) se divide 50/50.
  printCost       Decimal @default(0) @db.Decimal(10, 2)
  otherCosts      Decimal @default(0) @db.Decimal(10, 2)
  printedByUserId String?
  adminNotes      String?

  confirmedAt DateTime? // cuándo se confirmó el pago (se envió "Pedido confirmado")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  items     OrderItem[]
  user      User?       @relation("OrderCustomer", fields: [userId], references: [id], onDelete: SetNull)
  printedBy User?       @relation("OrderPrinter", fields: [printedByUserId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([createdAt])
  @@index([userId])
}

model OrderItem {
  id             String  @id @default(cuid())
  orderId        String
  itemId         String?
  // Copia de los datos al momento del pedido (aunque el item cambie o se borre)
  name           String
  collectionName String?
  imageUrl       String?
  unitPrice      Decimal @db.Decimal(10, 2)
  quantity       Int

  order Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  item  CollectionItem? @relation(fields: [itemId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([itemId])
}
